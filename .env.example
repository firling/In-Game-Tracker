# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token — https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=
# Application ID (onglet "General Information")
DISCORD_CLIENT_ID=
# ID du serveur. Renseigné : les commandes sont publiées instantanément sur ce
# serveur. Vide : publication globale (jusqu'à 1 h de propagation).
DISCORD_GUILD_ID=
# Salon où le bot publie les annonces de parties et les récaps
NOTIFICATION_CHANNEL_ID=
# Salon dédié TFT (optionnel — reprend NOTIFICATION_CHANNEL_ID si vide)
TFT_NOTIFICATION_CHANNEL_ID=
# IDs Discord autorisés à utiliser /apikey et /status en plus des administrateurs
# du serveur. Séparés par des virgules. Optionnel.
ADMIN_USER_IDS=

# ─── Riot Games ───────────────────────────────────────────────────────────────
# Clé API — https://developer.riotgames.com/
# Une clé de développement expire toutes les 24 h ; utilise /apikey pour la
# renouveler sans redémarrer le bot (elle est stockée en base).
# Une clé "personnelle" n'expire pas mais garde le même débit qu'une clé de dev.
RIOT_API_KEY=
# Plateforme des comptes suivis : euw1, eun1, na1, kr, br1, tr1, jp1, oc1…
RIOT_PLATFORM=euw1
# Budget de départ du limiteur : "development" (20 req/s, 100 req/2 min) ou
# "production" (500 req/10 s). Ce n'est qu'une valeur initiale : dès la première
# réponse, le bot adopte le quota réel annoncé par Riot (en-tête
# X-App-Rate-Limit). /status affiche le quota effectivement appliqué.
RIOT_KEY_TIER=development

# ─── Suivi ────────────────────────────────────────────────────────────────────
# Intervalle entre deux vérifications, en secondes (min 20)
TRACKING_INTERVAL=60
# Nombre maximum de comptes examinés par cycle
MAX_ACCOUNTS_PER_CYCLE=200
# Une partie sans résultat après ce délai (minutes) est abandonnée
GAME_TIMEOUT_MINUTES=180

# ─── Teamfight Tactics ────────────────────────────────────────────────────────
# Désactivé par défaut
TFT_ENABLED=false

# ─── Récapitulatif ────────────────────────────────────────────────────────────
DAILY_RECAP_ENABLED=true
# Format cron standard (minute heure jour mois jour-semaine)
DAILY_RECAP_CRON=0 8 * * *
TZ=Europe/Paris

# ─── Divers ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Port de l'endpoint /health utilisé par Docker. 0 pour le désactiver.
HEALTH_PORT=3000
# Emplacement de la base SQLite (par défaut /app/data en production)
# DATA_DIR=./data
