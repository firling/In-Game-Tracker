{
  "name": "in-game-tracker",
  "version": "2.0.0",
  "description": "Discord bot that tracks League of Legends games, ranks and LP for your server",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .test-build && node --test \".test-build/**/*.test.js\"",
    "watch": "tsc -w"
  },
  "keywords": [
    "discord",
    "bot",
    "league-of-legends",
    "riot",
    "tracker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.23.2",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
